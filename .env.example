DATA_API_KEY=
# Postgres is the system of record (workspaces, tasks, docs, memory).
# Local: bash run.sh postgres && bash run.sh install
# DATABASE_URL is what the API connects as. It must NOT be a superuser or BYPASSRLS role, or the
# workspace isolation policies are silently skipped (a managed server's admin role has BYPASSRLS).
# DATABASE_ADMIN_URL is used only by `python -m app.db.install`; leave it unset locally.
DATABASE_URL=postgresql+psycopg://flwn:flwn@localhost:5432/flwn
DATABASE_ADMIN_URL=
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_KEY=
MEMORY_CHAT_DEPLOYMENT=gpt-6-luna
EMBEDDING_DEPLOYMENT=embed-v-4-0

# Azure Blob Storage for files, chat media, recordings and reports. Blank disables /files routes.
# Access is through Entra ID (az login locally, managed identity on Azure): no keys.
AZURE_STORAGE_ACCOUNT_URL=
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300

# Workspace-scoped agent tokens for REST bearer auth and /mcp. 32+ chars. Blank = disabled.
MEMORY_TOKEN_SECRET=
MEMORY_TOKEN_ISSUER=flwn-data-engine
MEMORY_TOKEN_MAX_TTL_SECONDS=86400
# Comma-separated Host values allowed on /mcp (e.g. data.internal:8002). Blank = no check.
MCP_ALLOWED_HOSTS=

# Behavior tuning (defaults shown)
MEMORY_DEDUP_THRESHOLD=0.97
MEMORY_ORGANIZE_THRESHOLD=0.88
MEMORY_QUERY_REWRITE=true
RECENCY_HALF_LIFE_DAYS=14
SWEEP_SCAN_CAP=5000
SWEEP_BATCH_SIZE=20
ORGANIZE_SCAN_CAP=1000
